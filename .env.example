# Environment variables — rezisaktiva
#
# R1 sengaja tipis: situs publik static-first tanpa DB/auth produk
# (lihat product-discovery/06-engineering/environment-management.md).
#
# Tier:
#   Local      -> salin file ini ke .env.local (gitignored), isi nilai lokal
#   Preview    -> Vercel project > Preview env vars
#   Production -> Vercel project > Production env vars
#
# JANGAN commit nilai asli (.env.local / .env.production tidak boleh masuk git).

# Canonical URL situs — dipakai untuk meta/OG/sitemap.
# Lokal: http://localhost:3000
# Production: https://rezisaktiva.space
NEXT_PUBLIC_SITE_URL=http://localhost:3000
