{
  "name": "rezisaktiva",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "theme:build": "astryx theme build lib/astryx-theme.ts -o theme/astryx-theme.css",
    "theme:check": "astryx theme build lib/astryx-theme.ts -o theme/astryx-theme.css --check"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.4.6",
    "@astryxdesign/theme-neutral": "^0.4.6",
    "@stylexjs/stylex": "^0.19.0",
    "lenis": "^1.3.26",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.4.6",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.9.0"
}
